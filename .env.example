# IDLR-PTS Platform deployment environment contract
# Copy this file to .env and provide real values through a secret manager or
# deployment environment. Blank values are intentionally invalid where a
# service is enabled; the platform fails closed instead of using local defaults.

# -----------------------------------------------------------------------------
# Core application and HTTP policy
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_NAME=IDLR-PTS Platform
APP_VERSION=1.0.0
FRONTEND_URL=
VITE_APP_URL=
VITE_APP_ID=idlr-pts-platform
ALLOWED_ORIGINS=
LOG_LEVEL=info
MAX_REQUEST_SIZE=50mb
CROSS_SITE_COOKIES=false
CSP_ALLOW_INLINE_SCRIPTS=false
ENCRYPTION_KEY=
JWT_SECRET=
OWNER_OPEN_ID=
OAUTH_SERVER_URL=

# -----------------------------------------------------------------------------
# PostgreSQL and Redis
# -----------------------------------------------------------------------------
POSTGRES_URL=
DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_QUERY_TIMEOUT=15000
DB_STATEMENT_TIMEOUT=15000
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Keycloak identity and Permify authorization
# -----------------------------------------------------------------------------
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
PERMIFY_URL=
PERMIFY_TENANT_ID=

# -----------------------------------------------------------------------------
# Gateway, application security, and observability
# -----------------------------------------------------------------------------
APISIX_ADMIN_URL=
APISIX_API_KEY=
OPENAPPSEC_URL=
SENTRY_DSN=
TRACING_ENABLED=false
JAEGER_ENDPOINT=
METRICS_ENABLED=false
PROMETHEUS_PORT=
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
OPENCTI_URL=
OPENCTI_TOKEN=
WAZUH_URL=
WAZUH_USER=
WAZUH_PASSWORD=
OPA_URL=
KUBECOST_URL=

# -----------------------------------------------------------------------------
# Application microservices; set MICROSERVICES_ENABLED=false only when the
# database-backed monolith path is intentionally deployed without sidecars.
# -----------------------------------------------------------------------------
MICROSERVICES_ENABLED=true
MICROSERVICE_TIMEOUT_MS=3000
PARCEL_SERVICE_URL=
TITLE_SERVICE_URL=
TRANSACTION_SERVICE_URL=
PAYMENT_SERVICE_URL=
DOCUMENT_SERVICE_URL=
BLOCKCHAIN_SERVICE_URL=
IDENTITY_SERVICE_URL=
CRYPTO_AUDIT_SERVICE_URL=
GAZETTE_SERVICE_URL=

# -----------------------------------------------------------------------------
# Lakehouse, AI, document analysis, and CPU model policy
# -----------------------------------------------------------------------------
LAKEHOUSE_API_URL=
LAKEHOUSE_API_KEY=
LAKEHOUSE_ALLOWED_ORIGINS=
AI_SERVICE_URL=
OCR_SERVICE_URL=
FRAUD_SERVICE_URL=
AI_HEALTH_URL=
FRAUD_SCORE_BLOCK_THRESHOLD=
ODM_API_URL=
BUILDING_DETECTION_SERVICE_URL=
BUILDING_DETECTION_CONFIDENCE_THRESHOLD=
OCR_SERVICE_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PATH_STYLE_ACCESS=
ICEBERG_CATALOG_URI=
ICEBERG_WAREHOUSE_PATH=
# Private S3-compatible warehouse credentials used only by Lakehouse services.
# In production, inject these from a secret manager; do not reuse public asset keys.
LAKEHOUSE_S3_ACCESS_KEY=
LAKEHOUSE_S3_SECRET_KEY=
LAKEHOUSE_S3_BUCKET=idlr-lakehouse
LAKEHOUSE_S3_REGION=us-east-1
# Internal Apache Sedona/Spark execution plane. Do not expose these endpoints
# through the public gateway; the authenticated app submits only durable jobs.
SPARK_MASTER_URL=spark://sedona-spark-master:7077
SEDONA_JOB_WORKER_ID=sedona-worker-01
SEDONA_JOB_POLL_SECONDS=3
SEDONA_JOB_STALE_AFTER_SECONDS=300
SEDONA_JOB_MAX_RUNTIME_SECONDS=3600
SEDONA_WORKER_METRICS_PORT=9108
SEDONA_SPARK_WORKER_CORES=2
SEDONA_SPARK_WORKER_MEMORY=2g

# -----------------------------------------------------------------------------
# Dapr, Fluvio, Kafka compatibility, and Temporal workflows
# -----------------------------------------------------------------------------
DAPR_HTTP_URL=
DAPR_GRPC_URL=
DAPR_STATE_STORE=statestore
DAPR_PUBSUB_NAME=pubsub
FLUVIO_API_URL=
FLUVIO_CLUSTER_ENDPOINT=
FLUVIO_TOPIC_PREFIX=idlr
KAFKA_BROKERS=
KAFKA_CLIENT_ID=idlr-pts-platform
KAFKA_GROUP_ID=idlr-pts-platform-group
KAFKA_SSL_ENABLED=true
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_PROPERTY_TRANSACTION_TASK_QUEUE=
TEMPORAL_TLS_ENABLED=true
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=

# -----------------------------------------------------------------------------
# TigerBeetle native ledger and optional gRPC bridge
# -----------------------------------------------------------------------------
TIGERBEETLE_ADDRESS=
TIGERBEETLE_CLUSTER_ID=
TIGERBEETLE_REPLICAS=
TIGERBEETLE_GRPC_URL=
TIGERBEETLE_GRPC_TLS=true

# -----------------------------------------------------------------------------
# Hyperledger Fabric and smart-contract settlement
# -----------------------------------------------------------------------------
FABRIC_CONNECTION_PROFILE=
FABRIC_WALLET_PATH=
FABRIC_USER_ID=
FABRIC_ORG_MSP=
POLYGON_RPC_URL=
POLYGON_CHAIN_ID=
DEPLOYER_PRIVATE_KEY=
ESCROW_CONTRACT_ADDRESS=
PROPERTY_CONTRACT_ADDRESS=
MULTISIG_CONTRACT_ADDRESS=

# -----------------------------------------------------------------------------
# Payments, governmental systems, and external registries
# -----------------------------------------------------------------------------
MOJALOOP_API_URL=
MOJALOOP_API_KEY=
MOJALOOP_PARTICIPANT_ID=
MOJALOOP_PAYER_FSP_ID=
MOJALOOP_PAYEE_FSP_ID=
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE_URL=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_API_BASE_URL=
BANK_API_URL=
BANK_API_KEY=
CREDIT_BUREAU_API_URL=
CREDIT_BUREAU_API_KEY=
FIRS_API_URL=
FIRS_API_KEY=

# -----------------------------------------------------------------------------
# Email, SMS, and platform alert delivery
# -----------------------------------------------------------------------------
FROM_EMAIL=
FROM_NAME=IDLR PTS Platform
SENDGRID_API_KEY=
SENDGRID_API_BASE_URL=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_BASE_URL=
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=
ALERTS_ENABLED=true
ALERT_CHANNELS=email,slack
ALERT_EMAIL_RECIPIENTS=
ALERT_THRESHOLD_DOWNTIME=300
ALERT_THRESHOLD_ERROR_RATE=5
ALERT_THRESHOLD_RESPONSE_TIME=2000
# Required when Alertmanager is enabled. Use a trusted incident-management or
# operations webhook endpoint and inject the bearer credential from a secret manager.
ALERTMANAGER_WEBHOOK_URL=
ALERTMANAGER_WEBHOOK_TOKEN=
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL=60

# Durable case-concierge sessions and verified continuous AI training
CASE_CONCIERGE_SESSION_TTL_SECONDS=
FRAUD_TRAINING_START_DATE=
FRAUD_TRAINING_END_DATE=
FRAUD_TRAINING_MIN_LABELED=
MODEL_ARTIFACT_DIR=

# -----------------------------------------------------------------------------
# Governed mapping delivery and approved basemap providers
# -----------------------------------------------------------------------------
# Required in production. Templates must be credential-free HTTPS URLs containing
# {z}, {x}, and {y}; only the platform server communicates with providers.
GEO_BASEMAP_PUBLIC_ORIGIN=
GEO_BASEMAP_PRIMARY_URL=
# Optional independent approved fallback template. Leave blank only when the
# operational resilience policy explicitly permits a single provider.
GEO_BASEMAP_FALLBACK_URL=
GEO_BASEMAP_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# GeoAI evidence, verified spatial processing, and guarded GIS operations
# -----------------------------------------------------------------------------
# Comma-separated URI prefixes such as s3://idlr-geoai/,https://assets.example/
# The Lakehouse rejects any raster or point-cloud asset outside these prefixes.
GEOAI_ALLOWED_ASSET_URI_PREFIXES=
GEOAI_LAKEHOUSE_TIMEOUT_MS=120000
# Path to the PDAL executable within the Lakehouse image or host. Required only
# when LiDAR QC operations are enabled.
GEOAI_PDAL_BINARY=
# Cross-language, HMAC-authenticated geospatial delivery. Generate at least 32
# random characters and use the exact same secret in the TypeScript app, Go
# vector-tile service, Rust Cesium asset service, and Lakehouse authority.
GEO_DELIVERY_CAPABILITY_SECRET=
# Internal-only HTTP service URLs. Do not expose these directly through the
# public gateway; browsers and native clients use the same-origin delivery API.
GEO_TILE_SERVICE_URL=http://vector-tile-service:7021
GEO_CESIUM_ASSET_SERVICE_URL=http://cesium-asset-service:7022
GEO_SPATIAL_AUTHORITY_URL=http://lakehouse-api:8000
GEO_TILE_SERVICE_TIMEOUT_MS=10000
GEO_CESIUM_ASSET_SERVICE_TIMEOUT_MS=20000
GEO_SPATIAL_AUTHORITY_TIMEOUT_MS=120000
GEO_TILE_QUERY_TIMEOUT=8s
GEO_TILE_READINESS_TIMEOUT=2s
# Shared persistent directory: Lakehouse writes prepared 3D Tiles; the Rust
# service mounts it read-only and verifies manifests before streaming content.
GEO_3D_PREPARATION_ROOT=/data/geo-3d-assets
GEO_3D_ASSET_ROOT=/data/geo-3d-assets

# -----------------------------------------------------------------------------
# Context Globe public situational awareness (read-only; approved sources only)
# -----------------------------------------------------------------------------
# Generate at least 32 random characters and set the same value in the
# TypeScript middleware, Go stream gateway, and Rust temporal GeoJSON service.
CONTEXT_CAPABILITY_SECRET=
# Internal-only URLs. Browsers and native clients must use the authenticated
# same-origin middleware routes and never contact the public providers directly.
CONTEXT_STREAM_SERVICE_URL=http://context-stream-gateway:8091
CONTEXT_TILES_SERVICE_URL=http://context-tiles-service:8092
CONTEXT_DELIVERY_TIMEOUT_MS=8000
CONTEXT_STREAM_CONNECT_TIMEOUT_MS=8000
# Required by the National Weather Service. Identify this deployment and provide
# an operations contact; do not use a browser default or an anonymous agent.
CONTEXT_NWS_USER_AGENT=IDLR-PTS Context Globe (operations@example.com)
# The ingestion worker publishes normalized event notifications only after a
# PostgreSQL lineage commit and Iceberg snapshot write succeed.
CONTEXT_DAPR_PUBSUB=idlr-pubsub
CONTEXT_INGEST_METRICS_PORT=8093
# The worker ticks at this rate but enforces the approved source cadences itself:
# USGS every 60 seconds and NWS every 120 seconds.
CONTEXT_INGEST_POLL_SECONDS=15
# Durable Temporal reconciliation observes the protected Lakehouse status plane;
# it never mutates parcels, evidence, transactions, or public-context events.
TEMPORAL_CONTEXT_GLOBE_TASK_QUEUE=context-globe
CONTEXT_TEMPORAL_RECONCILE_SECONDS=300
CONTEXT_TEMPORAL_WORKFLOW_ID=context-globe-reconciliation-v1
CONTEXT_TEMPORAL_STATUS_TIMEOUT_MS=10000
# Dedicated Temporal worker queue for GeoAI evidence workflows.
TEMPORAL_GEOAI_TASK_QUEUE=
TEMPORAL_GEOAI_MAX_CONCURRENT_ACTIVITIES=4
TEMPORAL_GEOAI_MAX_CONCURRENT_WORKFLOWS=8
# Authenticated control plane for human-approved ArcGIS operations. These values
# are required only for execution or refresh; operation requests may be reviewed
# without granting this capability.
ARCGIS_GEOAI_CONTROL_PLANE_URL=
ARCGIS_GEOAI_CONTROL_PLANE_API_KEY=
ARCGIS_GEOAI_TIMEOUT_MS=120000

# Trusted GeoLibre browser companion. The GeoLibre deployment must separately
# set GEOLIBRE_EMBED_ORIGINS to this application's exact public origin; do not
# allow a wildcard origin in production.
GEOLIBRE_BASE_URL=

# -----------------------------------------------------------------------------
# Lakehouse container HTTP policy for GeoAI endpoints
# -----------------------------------------------------------------------------
LAKEHOUSE_CORS_ORIGINS=
LAKEHOUSE_API_PORT=8000
LAKEHOUSE_API_HOST=0.0.0.0


# -----------------------------------------------------------------------------
# Geo Innovation monitoring, interoperable discovery, and governed release
# -----------------------------------------------------------------------------
# Poll cadence for the durable Temporal monitor workflow. Active subscriptions
# also require a valid ISO-8601 interval (for example PT6H) and a complete
# policy-valid manifest in settings.manifest. Manual monitors never auto-run.
GEO_INNOVATION_MONITOR_POLL_SECONDS=300
GEO_INNOVATION_MONITOR_LIMIT=25
GEO_INNOVATION_MONITOR_WORKFLOW_ID=geo-innovation-monitor-scheduler-v1
# Optional public origin used when an approved privacy-preserving release is
# linked outside the platform. Protected STAC and OGC feature routes still use
# the main authenticated application URL and GeoAI view permission.
GEO_INNOVATION_PUBLIC_RELEASE_ORIGIN=
# Expo delivery remains optional; durable in-app alerts are always created first.
# A real EAS project ID is supplied only through the native mobile build env.
EXPO_PUSH_DELIVERY_ENABLED=true
