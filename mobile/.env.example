# Native IDLR GeoAI mobile release configuration.
# Provide values through EAS/build secrets or the secure release environment; do not commit live values.

# Absolute HTTPS URL for the platform gateway, for example https://platform.example.gov.ng
EXPO_PUBLIC_API_URL=

# Keycloak public PKCE-client configuration.
EXPO_PUBLIC_KEYCLOAK_URL=
EXPO_PUBLIC_KEYCLOAK_REALM=
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=
EXPO_PUBLIC_KEYCLOAK_SCOPES=openid profile email

# Required only when Expo push delivery is enabled. Omit to disable mobile push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional HTTPS tile endpoint for evidence-map basemaps.
EXPO_PUBLIC_GEOAI_MAP_TILE_URL=
